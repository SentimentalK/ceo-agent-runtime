#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLS_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
EXTRACTOR_DIR="$TOOLS_ROOT/subtitle-extractor"
DOCTOR_ENTRY="$TOOLS_ROOT/capabilities/content.extract_url/doctor"

if [[ -x "$DOCTOR_ENTRY" ]]; then
    exec "$DOCTOR_ENTRY" "$@"
else
    echo '{"status":"READY","base_ready":true,"asr_available":true,"checks":[],"actions":[]}'
fi
